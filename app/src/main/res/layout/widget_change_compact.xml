<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic" android:orientation="vertical"
    android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_pair" style="@style/WidgetText.Label"
            android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1"
            android:text="@string/widget_prl_1h" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        <ImageView android:id="@+id/w_stale_icon" style="@style/WidgetIcon"
            android:src="@drawable/ic_widget_stale" android:visibility="gone" />
        <TextView android:id="@+id/w_time" style="@style/WidgetText.Small"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_sample_time" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
        
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_trend" style="@style/WidgetIcon"
            android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_trend_up" />
        <TextView android:id="@+id/w_change" style="@style/WidgetText.Price"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:autoSizeMaxTextSize="22sp"
            android:text="@string/widget_sample_change" />
    </LinearLayout>
    <TextView android:id="@+id/w_price" style="@style/WidgetText.Small"
        android:layout_width="match_parent" android:layout_height="12dp"
        android:text="@string/widget_sample_price" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
