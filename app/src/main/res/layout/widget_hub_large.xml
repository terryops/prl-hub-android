                    android:id="@+id/w_prow2_dot"
                    style="@style/WidgetIcon"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_dot"
                    android:tint="#FFA6F4C5"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow2_label"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_label"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/w_prow2_bolt"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_bolt"
                    android:layout_marginStart="6dp"
                    android:tint="#FFFFC747"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow2_rate"
                    style="@style/WidgetText.Figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_rate_a"
                    android:layout_marginStart="3dp" />

                <ImageView
                        android:visibility="gone"
                    android:id="@+id/w_prow2_desktop"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_desktop"
                    android:layout_marginStart="8dp"
                    android:tint="#CCFFFFFF"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow2_workers"
                    style="@style/WidgetText.Rigs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_workers_a"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_prow3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                        android:visibility="gone"
                    android:id="@+id/w_prow3_dot"
                    style="@style/WidgetIcon"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_dot"
                    android:tint="#FFA6F4C5"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow3_label"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_label"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/w_prow3_bolt"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_bolt"
                    android:layout_marginStart="6dp"
                    android:tint="#FFFFC747"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow3_rate"
                    style="@style/WidgetText.Figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_rate_a"
                    android:layout_marginStart="3dp" />

                <ImageView
                        android:visibility="gone"
                    android:id="@+id/w_prow3_desktop"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_desktop"
                    android:layout_marginStart="8dp"
                    android:tint="#CCFFFFFF"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow3_workers"
                    style="@style/WidgetText.Rigs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_workers_a"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_prow4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                        android:visibility="gone"
                    android:id="@+id/w_prow4_dot"
                    style="@style/WidgetIcon"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_dot"
                    android:tint="#FFA6F4C5"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow4_label"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_label"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:id="@+id/w_prow4_bolt"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_bolt"
                    android:layout_marginStart="6dp"
                    android:tint="#FFFFC747"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow4_rate"
                    style="@style/WidgetText.Figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_rate_a"
                    android:layout_marginStart="3dp" />

                <ImageView
                        android:visibility="gone"
                    android:id="@+id/w_prow4_desktop"
                    style="@style/WidgetIcon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_widget_desktop"
                    android:layout_marginStart="8dp"
                    android:tint="#CCFFFFFF"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_prow4_workers"
                    style="@style/WidgetText.Rigs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/widget_sample_workers_a"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_prows_more"
                style="@style/WidgetText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="@string/widget_sample_label"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_divider_tx"
            style="@style/WidgetDivider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/w_tx_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_tx_title"
                style="@style/WidgetText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="@string/widget_recent" />

            <TextView
                android:id="@+id/w_tx_empty"
                style="@style/WidgetText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="@string/widget_no_transactions"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w_tx1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_tx1_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_arrow_down"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/w_tx1_amount"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_head"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/w_tx1_time"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_stamp"
                    android:layout_marginStart="6dp"
                    android:textColor="#99FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tx2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_tx2_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_arrow_down"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/w_tx2_amount"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_head"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/w_tx2_time"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_stamp"
                    android:layout_marginStart="6dp"
                    android:textColor="#99FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tx3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_tx3_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_arrow_down"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/w_tx3_amount"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_head"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/w_tx3_time"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_stamp"
                    android:layout_marginStart="6dp"
                    android:textColor="#99FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tx4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_tx4_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_arrow_down"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/w_tx4_amount"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_head"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/w_tx4_time"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_stamp"
                    android:layout_marginStart="6dp"
                    android:textColor="#99FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tx5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_tx5_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_arrow_down"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/w_tx5_amount"
