<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the full hashrate including its unit, with workers on their own line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic" android:orientation="vertical"
    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/w_price_area" android:layout_width="match_parent" android:layout_height="24dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_mark" style="@style/WidgetIcon"
            android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_stat_pearl" />
        <TextView android:id="@+id/w_pair" style="@style/WidgetText.Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="@string/widget_prl" android:textSize="9sp" />
        <TextView android:id="@+id/w_price" style="@style/WidgetText.Price"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:gravity="end|center_vertical"
            android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="20sp" android:text="@string/widget_sample_price" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_mining_area" android:layout_width="match_parent" android:layout_height="24dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_bolt" style="@style/WidgetIcon"
                android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_widget_bolt" />
            <TextView android:id="@+id/w_hashrate" style="@style/WidgetText.Figure"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp"
                android:text="@string/widget_sample_rate_total" android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_desktop" style="@style/WidgetIcon"
                android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_widget_desktop" />
            <TextView android:id="@+id/w_workers" style="@style/WidgetText"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp"
                android:text="@string/widget_sample_workers_total" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
