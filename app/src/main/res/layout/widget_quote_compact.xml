<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow one-row slots: full-width price, with two autosized change figures below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic" android:orientation="vertical"
    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/w_price_area" android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_mark" style="@style/WidgetIcon"
            android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_stat_pearl" />
        <TextView android:id="@+id/w_pair" style="@style/WidgetText.Label"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:text="@string/widget_prl"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        <ImageView android:id="@+id/w_stale_icon" style="@style/WidgetIcon"
            android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_widget_stale" android:visibility="gone" />
        <TextView android:id="@+id/w_time" style="@style/WidgetText.Small"
            android:layout_width="wrap_content" android:layout_height="match_parent" android:textSize="9sp"
            android:text="@string/widget_sample_time" />
    </LinearLayout>
    <TextView android:id="@+id/w_price" style="@style/WidgetText.Price"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="22sp" android:text="@string/widget_sample_price" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_change1h" style="@style/WidgetText.Figure"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/widget_sample_change_1h" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/w_change24h" style="@style/WidgetText.Figure"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="end" android:text="@string/widget_sample_change_24h" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</LinearLayout>
