<?xml version="1.0" encoding="utf-8"?>
<!-- Single-cell standard AppWidget for narrow home/cover-screen slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic" android:orientation="vertical"
    android:gravity="center" android:padding="6dp">
    <TextView android:id="@+id/w_mini_title" style="@style/WidgetText.Label"
        android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center" android:text="@string/widget_prl_1h"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
        android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/w_mini_value" style="@style/WidgetText.Price"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="@string/widget_sample_change_1h"
        android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="28sp" android:textColor="#FFFFB4A8" />
    <TextView android:id="@+id/w_mini_detail" style="@style/WidgetText.Small"
        android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center" android:text="@string/widget_sample_price"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
