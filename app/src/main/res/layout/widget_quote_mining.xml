<?xml version="1.0" encoding="utf-8"?>
<!-- Quote & Pool Monitor: the price, total real-time hashrate and online workers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_classic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:id="@+id/w_price_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_mark"
                style="@style/WidgetIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_stat_pearl" />

            <TextView
                android:id="@+id/w_pair"
                style="@style/WidgetText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/widget_prl"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_price"
                style="@style/WidgetText.Price"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="24sp"
                android:gravity="center_vertical|end"
                android:text="@string/widget_sample_price" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_mining_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/w_empty_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/w_empty_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_widget_add" />

                <TextView
                    android:id="@+id/w_empty"
                    style="@style/WidgetText.Figure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/widget_add_monitor"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_hashrate_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_bolt"
                    style="@style/WidgetIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_widget_bolt"
                    android:tint="#FFFFC747"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/w_hashrate"
                    style="@style/WidgetText.Figure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/widget_sample_rate_total"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_workers_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_desktop"
                    style="@style/WidgetIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_desktop" />

                <TextView
                    android:id="@+id/w_workers"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/widget_sample_workers_total"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_monitor_label"
                    style="@style/WidgetText.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_sample_label" />

                <ImageView
                    android:id="@+id/w_stale_icon"
                    style="@style/WidgetIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_widget_stale"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/w_pools_time"
                    style="@style/WidgetText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_sample_time" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
